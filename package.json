{
  "name": "nodered-user-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Manage the shared Node-RED adminAuth users file from a web page",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
